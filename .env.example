# Node 24+. Defaults below work with npm run dev.
# The API always binds to 0.0.0.0; HOST is intentionally not configurable.
# Render supplies PORT in production. This value is the local default.
PORT=3001
CLIENT_PORT=5173
# Vite forwards /api and /Photos to this address in development.
API_PROXY_TARGET=http://127.0.0.1:3001
# Relative to project root. SQLite file is created and seeded on first run.
DATABASE_PATH=./data/dogadopt.sqlite
# Comma-separated browser origins allowed to submit forms.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Enable behind HTTPS in production. For local HTTP leave false.
COOKIE_SECURE=false
SESSION_DAYS=7
NODE_ENV=development
