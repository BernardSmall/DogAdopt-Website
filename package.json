{
  "name": "dogadopt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.2",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
